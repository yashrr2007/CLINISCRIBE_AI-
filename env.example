# Copy this file to .env and fill in ONE of the Google options. Never commit .env.

# Option 1 (preferred): path to a service-account key file
GOOGLE_APPLICATION_CREDENTIALS=credentials/vision-key.json

# Option 2: a Google API key restricted to the Cloud Vision API
# GOOGLE_API_KEY=

# Privacy masking is ON by default. 0 turns it off (not recommended).
# MASK_PHI=1
# MASK_DATES=1
